# Copy to .env and replace all placeholder values.
# Never commit the real .env file.

# IP address or DNS name used in the browser to reach MeshCentral.
# Example: 192.168.10.35
MESHCENTRAL_HOSTNAME=CHANGE_ME_TO_SERVER_IP_OR_DNS

MONGO_USERNAME=meshcentral
MONGO_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
