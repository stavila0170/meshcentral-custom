# Copy to .env and replace all placeholder values.
# Never commit the real .env file.

# Address used in the browser and by downloaded MeshCentral agents.
# Example: 192.168.10.35 or mesh.example.org
MESHCENTRAL_HOSTNAME=CHANGE_ME_TO_SERVER_IP_OR_DNS

# External ports exposed by Docker.
MESHCENTRAL_HTTPS_PORT=4434
MESHCENTRAL_MPS_PORT=4433

# UI title shown by MeshCentral.
MESHCENTRAL_TITLE=SI

# Allow account creation during initial setup.
# After the first administrator account is created, consider setting this to false
# and regenerating config.json if you do not want public registration.
MESHCENTRAL_ALLOW_NEW_ACCOUNTS=true

# MongoDB root credentials used by the bundled MongoDB container.
# Use a long random password. Hex characters are easiest because they need no URL escaping.
MONGO_USERNAME=meshcentral
MONGO_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
